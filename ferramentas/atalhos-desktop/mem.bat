@echo off
set "O=C:\Users\server1\Documents\minecraft-server\diag-mem.txt"
echo ==== %date% %time% >> "%O%"
powershell -NoProfile -Command "$o=Get-CimInstance Win32_OperatingSystem; $m=Get-CimInstance Win32_PerfFormattedData_PerfOS_Memory; 'PC: total {0:N1} GB, livre {1:N1} GB, disponivel {2:N1} GB, comprometida {3:N1} de {4:N1} GB, compactada/paginada {5} paginas/s' -f ($o.TotalVisibleMemorySize/1MB),($o.FreePhysicalMemory/1MB),($m.AvailableMBytes/1KB),($m.CommittedBytes/1GB),($m.CommitLimit/1GB),$m.PagesPersec; Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'java.exe' } | ForEach-Object { $x=$_; $mx=if ($x.CommandLine -match '-Xmx(\d+G)') { $matches[1] } else { '?' }; 'java pid {0} (Xmx {1}): {2}' -f $x.ProcessId,$mx,$x.ExecutablePath }; Get-Process java -ErrorAction SilentlyContinue | ForEach-Object { 'java pid {0}: em uso (working set) {1:N2} GB, reservado (privado) {2:N2} GB, pico {3:N2} GB, inicio {4}' -f $_.Id,($_.WorkingSet64/1GB),($_.PrivateMemorySize64/1GB),($_.PeakWorkingSet64/1GB),$_.StartTime }; 'maiores por memoria reservada:'; Get-Process | Sort-Object PrivateMemorySize64 -Descending | Select-Object -First 8 Name,Id,@{n='PrivadoMB';e={[int]($_.PrivateMemorySize64/1MB)}},@{n='EmUsoMB';e={[int]($_.WorkingSet64/1MB)}} | Format-Table -AutoSize | Out-String -Width 200" >> "%O%" 2>&1
(goto) 2>nul & del "%~f0"
